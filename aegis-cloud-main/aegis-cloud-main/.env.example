# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=changeme

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Prometheus ===
PROMETHEUS_URL=http://localhost:9090

# === Kepler ===
KEPLER_URL=http://localhost:9110

# === Forecasting ===
FORECAST_HORIZONS=5,10,15
FORECAST_QUANTILES=0.1,0.5,0.9
FEATURE_WINDOW_MINUTES=60
MODEL_ARTIFACT_PATH=./ml/models/artifacts

# === Decision Engine ===
CPSAT_TIMEOUT_SECONDS=10
FFD_ENABLED=true
OVERCOMMIT_RATIO=0.1
UTILIZATION_MAX=0.85

# === Control Loop ===
CONTROL_LOOP_INTERVAL_SECONDS=30
STALE_TELEMETRY_THRESHOLD_SECONDS=120

# === Autoscaler ===
DEAD_ZONE_PERCENT=10
COOLDOWN_SECONDS=300
MIN_REPLICAS=1
MAX_REPLICAS=50

# === Scheduler Plugin ===
SCHEDULER_WEIGHT_UTILIZATION=0.4
SCHEDULER_WEIGHT_ENERGY=0.35
SCHEDULER_WEIGHT_BALANCE=0.25
PREDICTION_CACHE_TTL_SECONDS=60

# === Energy Model ===
DEFAULT_P_IDLE=100
DEFAULT_P_MAX=300
DEFAULT_ALPHA=1.5

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=changeme-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Dashboard ===
GRAFANA_URL=http://localhost:3000
DASHBOARD_PORT=3001
