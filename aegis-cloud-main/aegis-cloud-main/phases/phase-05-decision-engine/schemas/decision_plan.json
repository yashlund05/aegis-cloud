{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Plan",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "cycle_id": { "type": "string" },
    "solver_type": { "type": "string" },
    "objective_value": { "type": "number" },
    "solve_time_ms": { "type": "number" },
    "replica_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workload_id": { "type": "string" },
          "current_replicas": { "type": "integer" },
          "target_replicas": { "type": "integer" },
          "reason": { "type": "string" }
        },
        "required": ["workload_id", "current_replicas", "target_replicas", "reason"]
      }
    },
    "placement_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pod_name": { "type": "string" },
          "target_node": { "type": "string" },
          "score": { "type": "number" },
          "reason": { "type": "string" }
        },
        "required": ["pod_name", "target_node", "score", "reason"]
      }
    },
    "node_power_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": { "type": "string" },
          "action": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["node_id", "action", "reason"]
      }
    },
    "status": { "type": "string" }
  },
  "required": ["id", "timestamp", "cycle_id", "solver_type", "objective_value", "solve_time_ms", "replica_changes", "placement_decisions", "node_power_changes", "status"]
}
